
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Free Fire Tournament</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#080d18;color:#fff}
header{text-align:center;padding:28px 15px;background:linear-gradient(135deg,#1a1740,#111d35);border-bottom:2px solid #ff9d00}
.logo{font-size:32px;font-weight:900;color:#ffb000}
header p{color:#cbd5e1}
.container{max-width:520px;margin:22px auto;padding:16px}
.card{background:#121c2e;border:1px solid #293750;border-radius:16px;padding:20px;margin-bottom:18px}
h2{margin-top:0;color:#ffb000}
.rewards{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.reward{background:#1d2b40;border-radius:12px;text-align:center;padding:18px 8px}
.amount{font-size:30px;font-weight:bold;color:#35e68a}
label{display:block;margin:14px 0 7px;font-weight:bold}
input{width:100%;padding:14px;border-radius:9px;border:1px solid #3a4a65;background:#0a1220;color:white;font-size:16px}
button,.btn{display:block;width:100%;padding:14px;border:0;border-radius:10px;background:#ff9f00;color:#111;font-weight:bold;font-size:16px;text-align:center;text-decoration:none;cursor:pointer;margin-top:18px}
.note{color:#cbd5e1;font-size:14px;line-height:1.7}
.insta{color:#ffb000;font-size:19px;font-weight:bold;overflow-wrap:anywhere}
footer{text-align:center;color:#94a3b8;padding:20px;font-size:12px}
</style>
</head>
<body>
<header>
  <div class="logo">FREE FIRE</div>
  <h1>MEGA TOURNAMENT</h1>
  <p>Register • Play • Earn Rewards</p>
</header>

<main class="container">
  <section class="card">
    <h2>🏆 Tournament Rewards</h2>
    <div class="rewards">
      <div class="reward">
        <div class="amount">₹10</div>
        <div>Per Kill</div>
      </div>
      <div class="reward">
        <div class="amount">₹100</div>
        <div>Booyah Reward</div>
      </div>
    </div>
    <p class="note">Rewards are subject to result verification and the tournament's applicable rules.</p>
  </section>

  <section class="card">
    <h2>📝 Player Registration</h2>
    <form id="regForm">
      <label for="player">Player Name</label>
      <input id="player" name="player" required maxlength="60" placeholder="Enter your player name">

      <label for="uid">Free Fire UID</label>
      <input id="uid" name="uid" required inputmode="numeric" maxlength="30" placeholder="Enter your game UID">

      <label for="contact">Instagram ID or Phone Number</label>
      <input id="contact" name="contact" required maxlength="100" placeholder="Enter Instagram ID or phone">

      <button id="submitBtn" type="submit">REGISTER NOW</button>
      <p id="status" class="note" role="status"></p>
    </form>
  </section>

  <section class="card">
    <h2>💰 How to Claim Rewards</h2>
    <ol class="note">
      <li>Take a clear screenshot showing your kills or Booyah result.</li>
      <li>Send the screenshot to the Instagram ID below.</li>
      <li>Include your registered Player Name and Free Fire UID.</li>
      <li>Wait for result verification and payment confirmation.</li>
    </ol>
    <p class="note">For payment and reward claims, tap this Instagram ID:</p>
    <a class="btn" href="https://www.instagram.com/raghav.creator5/" target="_blank" rel="noopener">Instagram: @raghav.creator5</a>
  </section>
</main>

<footer>Free Fire Tournament • Play fair and follow the rules.</footer>

<script>
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxIXo0Akob18FzVX_3tmNnu-rDZztiGBgZmVI2kcofIx5cIbT2NV8JPZ25Eaa7xozY/exec";

document.getElementById("regForm").addEventListener("submit", async function(e){
  e.preventDefault();

  const btn = document.getElementById("submitBtn");
  const status = document.getElementById("status");

  const data = {
    player: document.getElementById("player").value.trim(),
    uid: document.getElementById("uid").value.trim(),
    contact: document.getElementById("contact").value.trim()
  };

  if(!data.player || !data.uid || !data.contact){
    status.textContent = "Please fill in all fields.";
    return;
  }

  btn.disabled = true;
  btn.textContent = "SENDING...";
  status.textContent = "Submitting registration...";

  try {
    await fetch(SCRIPT_URL, {
      method: "POST",
      mode: "no-cors",
      body: new URLSearchParams(data)
    });

    status.textContent = "Request sent. Please check with the tournament organiser if registration is confirmed.";
    this.reset();
  } catch(error) {
    status.textContent = "Could not send the request. Please try again.";
  } finally {
    btn.disabled = false;
    btn.textContent = "REGISTER NOW";
  }
});
</script>
</body>
</html>
